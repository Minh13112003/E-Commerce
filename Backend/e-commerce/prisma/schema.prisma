generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  password         String
  firstName        String
  lastName         String
  role             Role           @default(USER)
  refreshToken     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  age              Int?           @default(22)
  phonenumber      String         @default("091234567")
  rewardPoints     Int            @default(1000000)
  earnedPoints     Int            @default(0)
  referralCode     String?        @unique
  successReferrals Int            @default(0)
  bookings         Booking[]
  carts            Cart[]
  feedbacks        Feedback[]
  orders           Order[]
  payments         Payment[]
  notifications    Notification[]

  @@index([email])
  @@map("users")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @default(cuid())
  status          OrderStatus
  totalAmount     Decimal     @db.Decimal(15, 2)
  userId          String
  cartId          String?
  shippingAddress String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]
  cart            Cart?       @relation(fields: [cartId], references: [id])
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment         Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model Category {
  id              String            @id @default(uuid())
  name            String
  description     String
  slug            String            @unique
  imageUrl        String?
  imagePublicId   String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  products        ProductCategory[]
  primaryProducts Product[]         @relation("ProductPrimaryCategory")

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model Product {
  id                String            @id @default(uuid())
  name              String
  description       String
  price             Decimal           @db.Decimal(15, 2)
  stock             Int               @default(0)
  sku               String            @unique
  imagePublicId     String?
  imageURL          String?
  isActive          Boolean           @default(true)
  primaryCategoryId String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  productCategories ProductCategory[]
  primaryCategory   Category?         @relation("ProductPrimaryCategory", fields: [primaryCategoryId], references: [id])

  @@index([sku])
  @@index([isActive])
  @@map("products")
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([position])
  @@map("product_categories")
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Decimal  @db.Decimal(15, 2)
  productId String
  orderId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model CartItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  productId String
  cartId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("carts_items")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String
  checkedOut Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orders     Order[]

  @@index([userId])
  @@map("carts")
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  currency      String        @default("usd")
  paymentMethod String?
  transactionId String?
  userId        String
  orderId       String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([userId])
  @@index([transactionId])
  @@map("payments")
}

model Booking {
  id            String        @id @default(uuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  idTour        String
  idUser        String
  departureId   String?
  price         Decimal       @default(0) @db.Decimal(15, 2)
  originalPrice Decimal       @default(0) @db.Decimal(15, 2)
  quantity      Int           @default(1)
  adults        Int           @default(1)
  children      Int           @default(0)
  infants       Int           @default(0)
  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod @default(AT_OFFICE)
  notice        String?
  voucherId     String?
  tour          Tour          @relation(fields: [idTour], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [idUser], references: [id], onDelete: Cascade)
  voucher       Voucher?      @relation(fields: [voucherId], references: [id])
  departure     Departure?    @relation(fields: [departureId], references: [id])

  @@index([idUser])
  @@index([idTour])
  @@index([voucherId])
  @@index([departureId])
  @@map("bookings")
}

model Tour {
  id            String          @id @default(uuid())
  name          String
  imageUrl      String
  imagePublicId String
  duration      String
  rating        Float           @default(0.0)
  reviewsCount  Int             @default(0)
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  hasVat        Boolean         @default(true)

  // ===== CÁC TRƯỜNG THÊM MỚI ĐỂ PHÙ HỢP VỚI WEB =====

  departureFrom String          @default("TP. Hồ Chí Minh")  // Nơi khởi hành
  transport     String          @default("Máy bay")          // Phương tiện di chuyển
  included      String[]        @default([])                 // Dịch vụ bao gồm (Mạng lưới array text)
  notIncluded   String[]        @default([])                 // Dịch vụ không bao gồm
  notes         String?                                      // Lưu ý khác về tour

  // ===== LOẠI TOUR (PHÂN CẤP 3 CẤP) =====
  // Cấp 1: tourCountry - "Trong nước" | "Quốc tế"
  // Cấp 2: tourRegion  - "Miền Bắc" | "Miền Trung" | "Châu Âu" | "Đông Nam Á" ...
  // Cấp 3: tourCity    - "Hà Nội" | "Đà Nẵng" | "Pháp" | "Thái Lan" ...
  tourCountry   String?
  tourRegion    String?
  tourCity      String?

  // Quan hệ 1-Nhiều với bảng lịch trình chi tiết theo ngày
  schedules     TourSchedule[]
  departures    Departure[]

  @@index([tourCountry])
  @@index([tourCountry, tourRegion])
  @@index([tourCountry, tourRegion, tourCity])
  @@map("tours")
}

model TourSchedule {
  id          String   @id @default(uuid())
  tourId      String
  dayNumber   Int      // Ngày 1, Ngày 2...
  title       String   // Tiêu đề ngày: "TP.HCM - HÀ NỘI - NINH BÌNH - BÁI ĐÍNH"
  
  // Tách biệt hoạt động chi tiết theo các buổi (Có thể để trống - Optional)
  morning     String?  // Nội dung hoạt động buổi Sáng
  noon        String?  // Nội dung hoạt động buổi Trưa
  afternoon   String?  // Nội dung hoạt động buổi Chiều
  evening     String?  // Nội dung hoạt động buổi Tối
  night       String?  // Hoạt động hoặc thông tin nghỉ đêm (Vd: "Nghi đêm tại Ninh Bình")

  // Thông tin ăn uống để hiển thị nhãn (Vd: "Bữa ăn: Trưa - Tối")
  meals       String[] @default([]) // Lưu mảng các chuỗi: ["Sáng", "Trưa", "Tối"]

  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@unique([tourId, dayNumber])
  @@map("tour_schedules")
}

model Voucher {
  id            String    @id @default(uuid())
  code          String    @unique
  title         String
  subtitle      String
  expiry        String
  tag           String
  description   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  max           Int?
  value         Int       @default(0)
  reuse         Boolean   @default(false)
  status        Boolean   @default(true)
  userId        String?
  usercreatedId String?
  bookings      Booking[]

  @@map("vouchers")
}

model Feedback {
  id        String   @id @default(uuid())
  subject   String
  content   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("feedbacks")
}

model Departure {
  id             String    @id @default(uuid())
  tourCode       String    @unique
  tourId         String
  departureDate  DateTime
  availableSeats Int
  price          Decimal   @db.Decimal(15, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tour           Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@index([tourId])
  @@index([departureDate])
  @@map("departures")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  ONGOING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  AT_OFFICE
  BANK_TRANSFER
}

enum NotificationType {
  PASSWORD_CHANGED
  BOOKING_CREATED
  BOOKING_STATUS_UPDATED
}
